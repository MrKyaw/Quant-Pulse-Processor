    given-names: "Kyaw Kyaw"
    website: "https://github.com/MrKyaw"
license: MIT
repository-code: "https://github.com/MrKyaw/Quant-Pulse-Processor"
url: "https://github.com/MrKyaw/Quant-Pulse-Processor"
version: "0.1.0"
date-released: "2026-10-20"
keywords:
  - quantum computing
  - quantum algorithms
  - statevector simulator
  - quantum Fourier transform
  - Grover search
  - QAOA
  - variational quantum eigensolver
  - pulse-level control
  - DRAG
  - transmon
  - Lindblad
  - NumPy
